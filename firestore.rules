rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSheikh() { return isSignedIn() && request.auth.token.email == 'ahmedalbannatech@gmail.com'; }

    // Pillar 2: Validation Blueprints (No DB reads here)
    function isValidUser(data) {
      return data.keys().hasAll(['phoneNumber', 'displayName', 'createdAt']) &&
             data.keys().size() >= 3 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidTale(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'audioUrl', 'category', 'createdAt', 'isPublic', 'clapsCount', 'duration', 'transcription']) &&
             data.authorId == request.auth.uid &&
             data.audioUrl is string && data.audioUrl.size() < 1000 &&
             data.category in ['market', 'stories', 'farming', 'news', 'advice', 'other'] &&
             data.clapsCount == 0 &&
             data.createdAt == request.time;
    }

    function isValidResponse(data) {
      return data.keys().hasAll(['taleId', 'authorId', 'authorName', 'audioUrl', 'createdAt', 'duration']) &&
             data.authorId == request.auth.uid &&
             data.audioUrl is string && data.audioUrl.size() < 1000 &&
             data.createdAt == request.time;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['taleId', 'reporterId', 'createdAt', 'status', 'audioUrl', 'transcription']) &&
             data.reporterId == request.auth.uid &&
             data.audioUrl is string &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    // Collections
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'voiceAvatarUrl', 'voiceBio'])
      );

      match /saves/{taleId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /blocks/{blockedId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /follows/{followedId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /reports/{reportId} {
      allow read: if isSheikh();
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isSheikh() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    match /tales/{taleId} {
      // Pillar 8: Secure List Queries
      allow get: if isSignedIn() && isValidId(taleId);
      allow list: if isSignedIn(); 

      allow create: if isSignedIn() && isValidTale(incoming());
      
      // Pillar 4: Tiered Identity Logic & Action-Based Update Pattern
      allow update: if isSignedIn() && (
        // Action: Clap (Anyone signed in)
        (incoming().diff(existing()).affectedKeys().hasOnly(['clapsCount']) && 
         incoming().clapsCount == existing().clapsCount + 1) ||
        
        // Action: Edit (Owner only)
        (isOwner(existing().authorId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['transcription', 'category', 'isPublic']) &&
         incoming().category in ['market', 'stories', 'farming', 'news', 'advice', 'other'])
      );

      allow delete: if isOwner(existing().authorId) || isSheikh();

      match /responses/{responseId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidResponse(incoming());
        allow delete: if isOwner(existing().authorId);
      }
    }
  }
}
